# Application
SPRING_PROFILES_ACTIVE=local

# PostgreSQL (shared server, database-per-service)
POSTGRES_PORT=5432
POSTGRES_USER=ticketing
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ticketing
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=ticketing
DB_PASSWORD=change-me

# Per-service database names (Flyway targets)
DB_NAME_EVENT=event_db
DB_NAME_VENUE=venue_db
DB_NAME_RESERVATION=reservation_db
DB_NAME_PAYMENT=payment_db
DB_NAME_TICKET=ticket_db
DB_NAME_NOTIFICATION=notification_db
DB_NAME_ANALYTICS=analytics_db
DB_NAME_USER=user_db

# Service ports (host)
SERVER_PORT_GATEWAY=8080
SERVER_PORT_EVENT=8081
SERVER_PORT_VENUE=8082
SERVER_PORT_RESERVATION=8083
SERVER_PORT_PAYMENT=8084
SERVER_PORT_TICKET=8085
SERVER_PORT_NOTIFICATION=8086
SERVER_PORT_ANALYTICS=8087
SERVER_PORT_USER=8088

# Kafka
KAFKA_PORT=9092
KAFKA_EXTERNAL_HOST=localhost
KAFKA_KRAFT_CLUSTER_ID=abcdefghijklmnopqrstuv
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Keycloak
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_USER_PASSWORD=Change123!
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/ticketing
KEYCLOAK_CLIENT_ID=ticketing-api
KEYCLOAK_CLIENT_SECRET=change-me

# MinIO
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=tickets

# Payment provider
PAYMENT_PROVIDER_URL=https://example.invalid
PAYMENT_PROVIDER_SECRET=change-me
